# ─── WebSocket Backend URL ────────────────────────────────────────────
# DEV ONLY — Vite on :5173 talks to the Spring backend on :8080.
# Production builds leave this UNSET (or set it to an https/wss endpoint): the
# client then resolves the backend to its own served origin (`/game-ws`), keeping
# localhost out of the bundle. On Vercel/Render two-origin deploys set:
#   VITE_BACKEND_URL=https://<your-backend-host>/game-ws
# Use https (never http) — SockJS upgrades to wss automatically on secure origins.
VITE_BACKEND_URL=http://localhost:8080/game-ws

# ─── STUN Server ─────────────────────────────────────────────────────
# Default: stun:stun.l.google.com:19302 (public, no credentials).
VITE_STUN_URL=stun:stun.l.google.com:19302

# ─── TURN Server (optional — for cross-network WebRTC) ────────────────
# Uncomment and fill in to enable TURN relay for NAT traversal.
# You need a TURN server such as coturn, Twilio, or Metered.
#
# SECURITY WARNING: VITE_* variables are baked into the PUBLIC JavaScript bundle
# at build time. The TURN username/credential here can be read by any client, so
# for production use an ephemeral/temporary credential scheme (e.g. a TURN REST
# API time-limited credential, renewed per build) — never a permanent shared
# secret. Prefer `turns:` (TLS) on :443; the client also adds a `turns:` twin
# automatically for `turn:` URLs on :443.
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential